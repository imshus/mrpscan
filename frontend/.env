# ─────────────────────────────────────────────────────────────────────
# Expo frontend environment
#
# WARNING: every EXPO_PUBLIC_* value is INLINED INTO THE JS BUNDLE at
# build time and is readable by anyone with the APK. Put only public
# values here — never an API secret, webhook secret, or password.
#
# Expo caches env at bundle time: after editing this file restart with
#   npm run start:clean      (expo start --lan --clear)
# ─────────────────────────────────────────────────────────────────────

# ── Backend API base URL ─────────────────────────────────────────────
# Leave UNSET for local dev: constants/api.ts auto-detects the Metro LAN
# host and targets http://<your-lan-ip>:3000, which is what `--lan` needs
# for a physical device. Android emulator falls back to 10.0.2.2:3000.
# Set it only to force a fixed backend (staging, prod, tunnel, etc.).
EXPO_PUBLIC_API_URL=https://appapi.mrpscan.com
#EXPO_PUBLIC_API_URL=https://lillia-lamellose-sympodially.ngrok-free.dev

# ── Payments (Razorpay) ──────────────────────────────────────────────
# Publishable checkout key id only — matches RAZORPAY_KEY_ID in backend/.env.
# Used solely as a fallback; the backend normally returns razorpayKeyId
# on the order. The matching key SECRET must stay server-side.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_TXWh9N31S2rr2s

# ── Dev toggles (both opt-in; keep false for APK / production) ────────
# Shows the yellow on-screen OTP banner for testing without live SMS.
EXPO_PUBLIC_SHOW_DEV_OTP=false
# Serves static mock scan results instead of calling the backend + Gemini.
EXPO_PUBLIC_USE_MOCK_SCAN=false

# ── Contact Us (Settings) ────────────────────────────────────────────
# Support address the "Email Us" row addresses its message to. "Talk to Our
# Agent" opens the voice agent at https://voice.amitaash.com unless
# EXPO_PUBLIC_VOICE_AGENT_URL points somewhere else. Both public.
EXPO_PUBLIC_SUPPORT_EMAIL=info@mrpscan.com

# ── Pratham AI (bottom bar) ──────────────────────────────────────────
# Where the Dynamic Voice Agent server is hosted, e.g. https://ai.example.com
# (http/https or ws/wss; "/ws" is added). The app talks to it directly over a
# WebSocket — no browser. The server's PRATHAM_AI_URL, when set, overrides this.
EXPO_PUBLIC_PRATHAM_AI_URL=https://prathamai.mrpscan.com
