{
  "expo": {
    "name": "MRPscan",
    "slug": "pratham",
    "version": "1.0.185",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.jpeg",
    "scheme": "pratham",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amitaashitsolution",
      "buildNumber": "176",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-logo.jpeg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.amitaashitsolution",
      "versionCode": 186
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MRPscan to access your camera to scan jewellery tags.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MRPscan to access your photos to upload jewellery tag images.",
          "cameraPermission": "Allow MRPscan to access your camera to scan jewellery tags."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.razorpay.** { *; } -keep class com.google.android.gms.auth.api.phone.** { *; } -keep class me.furtado.smsretriever.** { *; } -dontwarn com.razorpay.** -dontwarn com.google.android.gms.auth.api.credentials.** -keepattributes InnerClasses,EnclosingMethod",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7943fc3a-2489-4310-8431-362187abe74b"
      }
    },
    "owner": "imshu"
  }
}
