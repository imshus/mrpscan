{
  "expo": {
    "name": "MRPscan",
    "slug": "pratham",
    "version": "1.0.386",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.jpeg",
    "scheme": "pratham",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amitaashitsolution",
      "buildNumber": "227",
      "icon": "./assets/images/ios-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MRPscan uses the camera to scan the price tags on your jewellery.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of a jewellery tag from your gallery to scan it.",
        "NSMicrophoneUsageDescription": "Talk to the MRPscan 24/7 voice assistant."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-logo.jpeg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.amitaashitsolution",
      "versionCode": 387
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MRPscan uses the camera to scan the price tags on your jewellery.",
          "microphonePermission": "Talk to the MRPscan 24/7 voice assistant.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a jewellery tag from your gallery to scan it.",
          "cameraPermission": "MRPscan uses the camera to scan the price tags on your jewellery.",
          "microphonePermission": "Talk to the MRPscan 24/7 voice assistant."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.razorpay.** { *; } -keep class com.google.android.gms.auth.api.phone.** { *; } -keep class me.furtado.smsretriever.** { *; } -dontwarn com.razorpay.** -dontwarn com.google.android.gms.auth.api.credentials.** -keepattributes InnerClasses,EnclosingMethod",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-mail-composer",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Talk to the MRPscan 24/7 voice assistant.",
          "iosBackgroundMode": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "androidForegroundService": false,
          "disableFFmpeg": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7943fc3a-2489-4310-8431-362187abe74b"
      }
    },
    "owner": "imshu"
  }
}
