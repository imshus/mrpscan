# Copy this file to .env and fill in real values.
# Only variables prefixed EXPO_PUBLIC_ are readable by the app — anything else here would be ignored.

# Backend base URL (no trailing slash, no /api/v1) — point this at wherever the backend
# from ../backend ends up running (e.g. your AWS instance).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Razorpay public key ID (safe to expose client-side — this is NOT the secret key)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Dev-only: shows a yellow banner with the OTP value instead of requiring real SMS.
# Leave false/unset in any build you're not personally testing on.
EXPO_PUBLIC_SHOW_DEV_OTP=false

# Dev-only: skips the real Gemini/OpenAI scan call and returns mock data — useful before
# GEMINI_API_KEY/OPENAI_API_KEY are set up on the backend.
EXPO_PUBLIC_USE_MOCK_SCAN=false
