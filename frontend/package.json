{
  "name": "mrpscan-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.33",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.24",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~57.0.14",
    "expo-mail-composer": "~57.0.2",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.25",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.31",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "jpeg-js": "^0.4.4",
    "lucide-react-native": "^1.18.0",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "^1.0.1",
    "react-native-blob-util": "^0.24.10",
    "react-native-pdf": "^7.0.5",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sms-retriever": "^1.1.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:web",
    "build:web": "expo export --platform web --output-dir dist/web --clear",
    "build:apk": "npm run typecheck && node scripts/build-apk.mjs",
    "build:aab": "npm run typecheck && node scripts/build-aab.mjs",
    "ui:debug:doctor": "node scripts/mobile-ui-debugger.mjs doctor",
    "ui:debug:build": "npm run typecheck && node scripts/mobile-ui-debugger.mjs build",
    "ui:debug:install": "node scripts/mobile-ui-debugger.mjs install",
    "ui:debug:start": "node scripts/mobile-ui-debugger.mjs start",
    "ui:debug:inspect": "node scripts/mobile-ui-debugger.mjs inspect",
    "ui:debug:screenshot": "node scripts/mobile-ui-debugger.mjs screenshot",
    "ui:debug:logs": "node scripts/mobile-ui-debugger.mjs logs",
    "ui:debug:reload": "node scripts/mobile-ui-debugger.mjs reload",
    "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android-sdk.ps1",
    "typecheck": "tsc --noEmit",
    "start": "cross-env EXPO_OFFLINE=1 expo start --lan",
    "start:clean": "cross-env EXPO_OFFLINE=1 expo start --lan --clear",
    "start:web": "cross-env EXPO_OFFLINE=1 expo start --web --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "cross-env EXPO_OFFLINE=1 expo start --android --lan",
    "ios": "cross-env EXPO_OFFLINE=1 expo start --ios",
    "web": "cross-env EXPO_OFFLINE=1 expo start --web --lan"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-in-app-updates"
        ]
      }
    }
  },
  "private": true
}
