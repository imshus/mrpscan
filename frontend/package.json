  },
  "scripts": {
    "build": "npm run typecheck && npm run build:web",
    "build:web": "expo export --platform web --output-dir dist/web --clear",
    "build:apk": "npm run typecheck && node scripts/build-apk.mjs",
    "ui:debug:doctor": "node scripts/mobile-ui-debugger.mjs doctor",
    "ui:debug:build": "npm run typecheck && node scripts/mobile-ui-debugger.mjs build",
    "ui:debug:install": "node scripts/mobile-ui-debugger.mjs install",
    "ui:debug:start": "node scripts/mobile-ui-debugger.mjs start",
    "ui:debug:inspect": "node scripts/mobile-ui-debugger.mjs inspect",
    "ui:debug:screenshot": "node scripts/mobile-ui-debugger.mjs screenshot",
    "ui:debug:logs": "node scripts/mobile-ui-debugger.mjs logs",
    "ui:debug:reload": "node scripts/mobile-ui-debugger.mjs reload",
    "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android-sdk.ps1",
    "typecheck": "tsc --noEmit",
    "start": "cross-env EXPO_OFFLINE=1 expo start --lan",
    "start:clean": "cross-env EXPO_OFFLINE=1 expo start --lan --clear",
    "start:web": "cross-env EXPO_OFFLINE=1 expo start --web --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "cross-env EXPO_OFFLINE=1 expo start --android --lan",
    "ios": "cross-env EXPO_OFFLINE=1 expo start --ios",
    "web": "cross-env EXPO_OFFLINE=1 expo start --web --lan"
  },
  "private": true
